# ==============================================================================
# Plantilla de Variables de Entorno - Bot Guardián (WFM Real-Time Sentinel) v1.0
# Copiar este archivo a `.env` para pruebas locales. Nunca subir `.env` al repositorio.
# ==============================================================================

# --- Servidor HTTP (Google Cloud Run asigna PORT automáticamente) ---
PORT=8080
HOST=0.0.0.0
POLL_INTERVAL_SECONDS=15
TIMEZONE_OFFSET_HOURS=-5

# --- URLs y Credenciales de la Plataforma WFM ---
WFM_DASHBOARD_URL=https://wfm-plataforma.ejemplo.com/realtime/coach
WFM_LOGIN_URL=https://wfm-plataforma.ejemplo.com/login
WFM_USERNAME=usuario_wfm_servicio
WFM_PASSWORD=cambiar_por_secreto_seguro

# --- Canal de Transmisión (Google Chat Webhook Oficial) ---
GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/XXXXXXXXX/messages?key=YYYYYYYYY&token=ZZZZZZZZZ

# --- Umbrales de Alerta WFM (en segundos) ---
THRESHOLD_LONG_CALL=900
THRESHOLD_OVER_BREAK=900
THRESHOLD_OVER_LUNCH=2700

# --- Palabras clave para clasificación de estados (separadas por coma) ---
WFM_CALL_STATES=en llamada,on call,in call,talking,acd,llamada
WFM_BREAK_STATES=break,descanso,pausa,baño,auxiliar
WFM_LUNCH_STATES=lunch,almuerzo,comida

# --- Selectores CSS del DOM (Ajustar según la grilla del portal WFM) ---
SELECTOR_USERNAME_INPUT=input[name='username'], input[type='email'], #username
SELECTOR_PASSWORD_INPUT=input[name='password'], input[type='password'], #password
SELECTOR_LOGIN_BUTTON=button[type='submit'], #login-btn
SELECTOR_AGENT_ROWS=table#agents-grid tbody tr, .agent-row
SELECTOR_AGENT_NAME=.agent-name, td:nth-child(1)
SELECTOR_AGENT_STATE=.agent-state, td:nth-child(2)
SELECTOR_AGENT_TIME=.agent-time, td:nth-child(3)
